# Template for secrets/secrets.env. ALL VALUES BELOW ARE FAKE: same format as the real ones, but
# they will not authenticate. Replace every "EDIT..." value with your own.
#
#   cp secrets/secrets.env.example secrets/secrets.env
#   chmod 600 secrets/secrets.env
#   ${EDITOR:-vi} secrets/secrets.env       # no nano on ROQUO; vi: i, Esc, :wq
#
# secrets/secrets.env is ignored by git (.gitignore: secrets/*). Never commit or share it.
# Shell syntax: KEY="value", no spaces around "=". The file is sourced by bash.

# --- IBM Quantum Platform (creates the Prefect block 'ibm-runner' for sampling) -----------------
# API key: https://quantum.cloud.ibm.com -> dashboard -> API key (44 characters; shown once).
IBM_API_KEY="EDIT_aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789AbCdEf"
# Instance CRN: https://quantum.cloud.ibm.com -> Instances -> your instance -> CRN.
IBM_CRN="crn:v1:bluemix:public:quantum-computing:us-east:a/EDIT0123456789abcdef0123456789ab:EDIT0123-4567-89ab-cdef-0123456789ab::"
# Backend name, as listed under Compute resources for that instance.
IBM_BACKEND="EDIT_ibm_kingston"

# --- Prefect Cloud (optional) -----------------------------------------------------------------
# Keep both lines commented out to use the profile from `prefect cloud login` (setup how-to,
# Step 5). Do not set them to "": an empty PREFECT_API_URL hides that profile. To use them
# instead, remove the "# " and fill in: API URL from `prefect config view` after login (account
# and workspace UUIDs), API key from Prefect Cloud -> your profile -> API keys ("pnu_...").
# PREFECT_API_URL="https://api.prefect.cloud/api/accounts/<uuid>/workspaces/<uuid>"
# PREFECT_API_KEY="pnu_..."
