#!/bin/bash{% if modules is defined %} -l{% endif %}
#SBATCH --partition={{ partition }}
{%- if account is defined %}
#SBATCH --account={{ account }}
{%- endif %}
{%- if memory is defined %}
#SBATCH --mem={{ memory }}
{%- endif %}
#SBATCH --nodes={{ num_nodes }}
{%- if ntasks is defined %}
#SBATCH --ntasks={{ ntasks }}
{%- endif %}
{%- if mpiprocs is defined %}
#SBATCH --ntasks-per-node={{ mpiprocs }}
{%- endif %}
{%- if ompthreads is defined %}
#SBATCH --cpus-per-task={{ ompthreads }}
{%- endif %}
{%- if walltime is defined %}
#SBATCH --time={{ walltime }}
{%- endif %}
#SBATCH --output={{ work_dir }}/output.out
#SBATCH --error={{ work_dir }}/output.err
{%- if qpu is defined %}
#SBATCH --qpu={{ qpu }}
{%- endif %}
{%- if gres is defined %}
#SBATCH --gres={{ gres }}
{%- endif %}

{%- if modules is defined %}
{% for module in modules %}
module load {{ module }}
{%- endfor %}
{%- endif %}

{%- if pre_commands is defined %}
{% for line in pre_commands %}
{{ line }}
{%- endfor %}
{%- endif %}

{%- if environments is defined %}
{% for k, v in environments.items() %}
export {{ k }}="{{ v }}"
{%- endfor %}
{%- endif %}

cd {{ work_dir }}

QCSC_PREFECT_EXECUTABLE="{{ executable }}"
if [ -z "${QCSC_PREFECT_EXECUTABLE}" ]; then
  echo "QCSC Prefect preflight failed: executable path is empty." >&2
  exit 127
fi
case "${QCSC_PREFECT_EXECUTABLE}" in
  */*)
    if [ ! -x "${QCSC_PREFECT_EXECUTABLE}" ]; then
      echo "QCSC Prefect preflight failed: executable '${QCSC_PREFECT_EXECUTABLE}' does not exist or is not executable on this HPC node." >&2
      exit 127
    fi
    ;;
  *)
    if ! command -v "${QCSC_PREFECT_EXECUTABLE}" >/dev/null 2>&1; then
      echo "QCSC Prefect preflight failed: executable '${QCSC_PREFECT_EXECUTABLE}' was not found on PATH on this HPC node." >&2
      exit 127
    fi
    ;;
esac

{% if launcher == "srun" -%}
{# srun inside an sbatch inherits SLURM_CPUS_PER_TASK / SLURM_TRES_PER_TASK from the parent
   allocation, which conflicts with this job's --cpus-per-task ("cpus-per-task set by two
   different environment variables"). Unset them so srun uses this script's #SBATCH values. #}
unset SLURM_CPUS_PER_TASK SLURM_TRES_PER_TASK
{% endif -%}
{% if launcher != "single" -%}
{{ launcher }}{% if mpi_options is defined %} {{ mpi_options | join(' ') }}{% endif %} "${QCSC_PREFECT_EXECUTABLE}"
{%- else -%}
"${QCSC_PREFECT_EXECUTABLE}"
{%- endif %}
{%- if arguments is defined -%}
{{ ' ' ~ arguments | join(' ') }}
{%- endif -%}
